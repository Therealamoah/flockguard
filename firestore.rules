rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() {
      return request.auth != null;
    }

    // backend/app/core/deps.py::get_current_org_id falls back to the
    // caller's own uid whenever no `org_id` custom claim is set on their
    // token - and nothing in this codebase ever sets that claim today, so
    // every real org_id currently equals its owner's uid. Reading a custom
    // claim that doesn't exist throws in Firestore rules (unlike a normal
    // map lookup), so the "in" check must come first or the uid fallback
    // below would never actually run.
    function callerOrgId() {
      return ('org_id' in request.auth.token) ? request.auth.token.org_id : request.auth.uid;
    }

    function inOrg(orgId) {
      return isAuth() && callerOrgId() == orgId;
    }

    // ---------------------------------------------------------------
    // 100% of production reads/writes happen server-side through the
    // FastAPI backend using the Firebase Admin SDK (backend/app/core/
    // firestore.py), which is NOT subject to these rules. The frontend
    // only uses Firebase Auth (frontend/src/lib/firebase.js) - it never
    // imports firebase/firestore, so no client ever reads or writes here
    // directly today.
    //
    // These rules are therefore a break-glass backstop, not the live
    // authorization mechanism: if the public web API key were ever used
    // directly against Firestore (misconfigured client, leaked config,
    // a future feature), this keeps every organization's data walled off
    // from every other org and from unauthenticated callers, and refuses
    // every write outright - since a client write would skip the Risk
    // Engine / Alert Engine entirely and leave records the rest of the
    // app can't render (e.g. every screen assumes risk_score/risk_status
    // exist on a flock_check).
    // ---------------------------------------------------------------

    match /organizations/{orgId} {
      allow read: if inOrg(orgId);
      allow write: if false;

      match /farms/{farmId} {
        allow read: if inOrg(orgId);
        allow write: if false;

        match /houses/{houseId} {
          allow read: if inOrg(orgId);
          allow write: if false;

          match /flocks/{flockId} {
            allow read: if inOrg(orgId);
            allow write: if false;
          }

          match /flock_checks/{checkId} {
            allow read: if inOrg(orgId);
            allow write: if false;
          }

          match /inspections/{inspectionId} {
            allow read: if inOrg(orgId);
            allow write: if false;
          }
        }
      }

      match /alerts/{alertId} {
        allow read: if inOrg(orgId);
        allow write: if false;
      }

      // Team memberships: readable by any member of the org (seeing who
      // has access isn't sensitive), never writable by a client - roles,
      // status and org_id custom claims are only ever changed by the
      // backend (backend/app/api/routes/team.py), never by a direct write.
      match /members/{memberId} {
        allow read: if inOrg(orgId);
        allow write: if false;
      }

      // Invitations carry other people's email addresses and pending
      // access grants - never exposed to any client, including members of
      // the inviting org. Accepting one goes through the backend
      // (POST /team/invitations/accept), which verifies the invitation's
      // email against the caller's own verified token email.
      match /invitations/{invitationId} {
        allow read, write: if false;
      }

      // Billing/subscription data - backend-only, same reasoning as above.
      match /subscription/{docId} {
        allow read, write: if false;
      }

      // FlockGuard Agent audit log and recommendations (backend/app/agent/,
      // backend/app/api/routes/agent.py). Readable by org members for the
      // same reason alerts are; never written directly by a client - every
      // agent run and recommendation is produced by the backend's own
      // controlled tool-calling loop, never by anything a client could send.
      match /agent_runs/{runId} {
        allow read: if inOrg(orgId);
        allow write: if false;
      }

      match /agent_recommendations/{recommendationId} {
        allow read: if inOrg(orgId);
        allow write: if false;
      }
    }

    // No `users` collection exists in this app - no user-profile document
    // is ever created (confirmed: no `.collection("users")` anywhere in
    // the backend). Add a scoped rule here if that ever changes, rather
    // than carrying unused scaffolding.

    // Curated poultry reference knowledge (RAG - backend/app/services/
    // knowledge_service.py) is global, not organization-scoped, but still
    // backend-only: ingestion/approval happens through
    // backend/scripts/ingest_knowledge.py and knowledge_service.py, never
    // through a client write, and retrieval always goes through the
    // search_poultry_knowledge tool (which filters to approved+enabled
    // documents) rather than a direct client read of the raw collection.
    match /knowledge_documents/{documentId} {
      allow read, write: if false;
    }

    match /knowledge_chunks/{chunkId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
