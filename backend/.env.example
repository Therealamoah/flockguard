ENVIRONMENT=development
# Set ENVIRONMENT=production explicitly on Render. Anything other than the
# literal "development" is treated as production-like (restrictive CORS,
# /debug disabled) - see app/main.py - so an unset/typo'd value fails closed.

# Vite bumps to 5174/5175 if 5173 is already in use - list every port you
# might land on so CORS doesn't silently block the browser locally.
# In production, set this to the deployed frontend URL(s) - e.g. the
# Vercel deployment URL - not a wildcard.
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:5175"]

FIREBASE_PROJECT_ID=
# Paste the full service account JSON as a single line, or leave blank to
# use Application Default Credentials / GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_SERVICE_ACCOUNT_JSON=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI provider config, OpenAI-chat-completions-compatible - grok_service.py
# works unchanged against any of these, it's just a base URL + model name
# swap. Currently running on Groq (console.groq.com - a school-issued key,
# NOT the same company as xAI's Grok despite the similar name; Groq hosts
# open models - Llama, GPT-OSS, Qwen, etc. - on its own inference hardware).
#
#   Groq (current):  GROK_API_BASE_URL=https://api.groq.com/openai/v1
#                     GROK_MODEL=openai/gpt-oss-20b
#   Direct xAI Grok:  GROK_API_BASE_URL=https://api.x.ai/v1
#                     GROK_MODEL=grok-4
#   OpenRouter:       GROK_API_BASE_URL=https://openrouter.ai/api/v1
#                     GROK_MODEL=x-ai/grok-4
GROK_API_KEY=
GROK_API_BASE_URL=https://api.groq.com/openai/v1
GROK_MODEL=openai/gpt-oss-20b
# Keep capped - a free/education-tier key's rate and context limits are
# usually much lower than a paid one.
GROK_MAX_TOKENS=800

# Rate limits (slowapi/limits string format, e.g. "20/minute") on the AI and
# upload endpoints only - protects AI credits and storage from abuse without
# throttling normal Flock Check usage. Defaults shown are usually fine as-is.
# RATE_LIMIT_ASK=15/minute
# RATE_LIMIT_MEDIA_UPLOAD=30/minute
# RATE_LIMIT_FLOCK_CHECK=30/minute

# Max upload sizes in MB, enforced server-side (never trust the frontend or
# a file's extension) in app/services/media_validation.py.
# MAX_IMAGE_UPLOAD_MB=8
# MAX_AUDIO_UPLOAD_MB=20

# Team invite emails (app/services/email_service.py). Left blank, invites
# still work (the invited person just signs in with that email directly)
# but no email gets sent - the frontend falls back to "share this invite
# directly".
#
# Gmail SMTP setup:
#   1. Turn on 2-Step Verification on the Gmail account that will send these.
#   2. Create an App Password at https://myaccount.google.com/apppasswords
#      (a regular Gmail password will NOT work here).
#   3. SMTP_USERNAME is the full Gmail address; SMTP_PASSWORD is the
#      16-character App Password (spaces don't matter).

# SMTP_FROM_EMAIL=            # defaults to SMTP_USERNAME if blank
# SMTP_FROM_NAME=FlockGuard

# Paystack (real payment processing for Starter/Growth/Pro - see
# app/services/paystack_service.py and PLAN_CATALOG in
# app/services/billing_service.py). Left blank, PILOT stays free and fully
# usable, but /billing/checkout returns a clear "not configured yet" error
# instead of pretending to charge anyone.
#
# Setup:
#   1. dashboard.paystack.com -> Settings -> API Keys & Webhooks for the
#      secret/public keys (use test keys while developing).
#   2. dashboard.paystack.com -> Plans -> Create Plan, once per paid tier -
#      GHS, monthly interval, amount matching PLAN_CATALOG's price_ghs
#      (249 / 549 / 1199). Paste each plan's code (plm_...) below - Paystack
#      ties recurring billing to the Plan itself, not a raw amount, so
#      these must exist before checkout works.
#   3. Same dashboard page -> Webhooks -> set the URL to
#      {your deployed API URL}/billing/webhook (Paystack can't reach
#      localhost directly - use `ngrok http 8000` or similar for local
#      testing and paste the forwarded https URL there instead).
# PAYSTACK_SECRET_KEY=
# PAYSTACK_PUBLIC_KEY=
# PAYSTACK_PLAN_CODE_STARTER=
# PAYSTACK_PLAN_CODE_GROWTH=
# PAYSTACK_PLAN_CODE_PRO=
