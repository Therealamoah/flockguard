ENVIRONMENT=development
# Set ENVIRONMENT=production explicitly on Render. Anything other than the
# literal "development" is treated as production-like (restrictive CORS,
# /debug disabled) - see app/main.py - so an unset/typo'd value fails closed.

# Vite bumps to 5174/5175 if 5173 is already in use - list every port you
# might land on so CORS doesn't silently block the browser locally.
# In production, set this to the deployed frontend URL(s) - e.g. the
# Vercel deployment URL - not a wildcard.
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:5175"]

FIREBASE_PROJECT_ID=
# Paste the full service account JSON as a single line, or leave blank to
# use Application Default Credentials / GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_SERVICE_ACCOUNT_JSON=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Temporary: routed through OpenRouter (proxies to x-ai/grok-*) until the
# school issues a direct xAI key. To switch to direct Grok later:
#   GROK_API_BASE_URL=https://api.x.ai/v1
#   GROK_MODEL=grok-4.3
GROK_API_KEY=
GROK_API_BASE_URL=https://openrouter.ai/api/v1
GROK_MODEL=x-ai/grok-4.3
# OpenRouter's free-credit balance can't cover this model's 65536-token
# default response length; keep it capped until a paid key is in.
GROK_MAX_TOKENS=800

# Rate limits (slowapi/limits string format, e.g. "20/minute") on the AI and
# upload endpoints only - protects AI credits and storage from abuse without
# throttling normal Flock Check usage. Defaults shown are usually fine as-is.
# RATE_LIMIT_ASK=15/minute
# RATE_LIMIT_MEDIA_UPLOAD=30/minute
# RATE_LIMIT_FLOCK_CHECK=30/minute

# Max upload sizes in MB, enforced server-side (never trust the frontend or
# a file's extension) in app/services/media_validation.py.
# MAX_IMAGE_UPLOAD_MB=8
# MAX_AUDIO_UPLOAD_MB=20
